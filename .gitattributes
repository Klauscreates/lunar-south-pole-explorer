# Science snapshots are byte-addressed by SHA-256: never normalize them.
outputs/** -text
data/** -text
apps/web/public/** -text
# Exports pin source hashes; keep LF even under core.autocrlf=true.
*.py text eol=lf
*.sh text eol=lf
*.csv whitespace=cr-at-eol
*.npy binary
*.png binary
*.jpg binary
*.pdf binary
